{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "qa-wsl-web-20261110-spike",
    "namespace": "ca-test",
    "labels": {
      "qa.wsl/owner": "qa-wsl-web-20261110"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 360,
    "template": {
      "metadata": {
        "labels": {
          "qa.wsl/owner": "qa-wsl-web-20261110"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "k6",
            "image": "grafana/k6:0.54.0",
            "args": [
              "run",
              "--no-color",
              "--quiet",
              "/test/load.js"
            ],
            "env": [
              {
                "name": "PROFILE",
                "value": "spike"
              },
              {
                "name": "SUMMARY_STDOUT",
                "value": "true"
              },
              {
                "name": "LEGACY_BASIC_USER",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "qa-wsl-web-20261110",
                    "key": "username"
                  }
                }
              },
              {
                "name": "LEGACY_BASIC_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "qa-wsl-web-20261110",
                    "key": "password"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1000m",
                "memory": "512Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "test",
                "mountPath": "/test",
                "readOnly": true
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "test",
            "configMap": {
              "name": "qa-wsl-web-20261110"
            }
          }
        ]
      }
    }
  }
}