{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "qa-ca-k6-20261110",
    "namespace": "ca-test",
    "labels": {
      "app.kubernetes.io/name": "qa-ca-k6-20261110",
      "qa.wsl/owner": "codex-autoscaler-20261110"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 420,
    "ttlSecondsAfterFinished": 3600,
    "template": {
      "metadata": {
        "labels": {
          "qa.wsl/owner": "codex-autoscaler-20261110",
          "qa.wsl/component": "k6"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "k6",
            "image": "grafana/k6:0.54.0",
            "args": [
              "run",
              "/test/load.js"
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "scripts",
                "mountPath": "/test",
                "readOnly": true
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "scripts",
            "configMap": {
              "name": "qa-ca-k6-20261110"
            }
          }
        ]
      }
    }
  }
}